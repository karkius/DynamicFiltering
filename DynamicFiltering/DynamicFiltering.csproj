<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>DynamicFiltering</RootNamespace>
    <AssemblyName>DynamicFiltering</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <Authors>karkius</Authors>
    <Description>Runtime filtering by SQL Server views for Entity Framework 6: builds entity types from view schemas at startup and joins the filtered view with any entity query.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>entityframework;ef6;dynamic;filter;sql-view</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EntityFramework" Version="6.4.4" />
    <PackageReference Include="LinqKit" Version="1.1.3.1" />
    <PackageReference Include="System.Linq.Dynamic" Version="1.0.7" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.Data" />
  </ItemGroup>

</Project>
